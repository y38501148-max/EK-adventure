[gd_scene load_steps=2 format=3 uid="uid://hud_exploding_konjac"]

[ext_resource type="Script" path="res://scripts/ui/Hud.gd" id="1_hud"]

[node name="Hud" type="PanelContainer"]
custom_minimum_size = Vector2(0, 96)
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TopRow" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HeroLabel" type="Label" parent="Margin/Rows/TopRow" unique_name_in_owner=true]
layout_mode = 2
size_flags_horizontal = 3
text = "ExplodingKonjac"

[node name="PhaseLabel" type="Label" parent="Margin/Rows/TopRow" unique_name_in_owner=true]
layout_mode = 2
text = "阶段：准备"

[node name="StatsLabel" type="Label" parent="Margin/Rows/TopRow" unique_name_in_owner=true]
layout_mode = 2
text = "生命 80  能量 3/3"

[node name="BottomRow" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PilesLabel" type="Label" parent="Margin/Rows/BottomRow" unique_name_in_owner=true]
layout_mode = 2
size_flags_horizontal = 3
text = "抽牌堆 0  手牌 0  弃牌堆 0  消耗 0"

[node name="DrawButton" type="Button" parent="Margin/Rows/BottomRow"]
custom_minimum_size = Vector2(96, 34)
layout_mode = 2
text = "抽牌"

[node name="EndTurnButton" type="Button" parent="Margin/Rows/BottomRow"]
custom_minimum_size = Vector2(96, 34)
layout_mode = 2
text = "结束回合"

[node name="MenuButton" type="Button" parent="Margin/Rows/BottomRow"]
custom_minimum_size = Vector2(96, 34)
layout_mode = 2
text = "菜单"

[connection signal="pressed" from="Margin/Rows/BottomRow/DrawButton" to="." method="_on_draw_button_pressed"]
[connection signal="pressed" from="Margin/Rows/BottomRow/EndTurnButton" to="." method="_on_end_turn_button_pressed"]
[connection signal="pressed" from="Margin/Rows/BottomRow/MenuButton" to="." method="_on_menu_button_pressed"]

